# Copy to .env locally. Never commit real credentials.
# The web installer supplies public origin/trusted proxy for the local Caddy setup.
HARMONICA_PUBLIC_ORIGIN=https://harmonica.observe.tw
HARMONICA_TRUST_PROXY=1

# Saved local `codex login` session; separate paid API mode is opt-in.
HARMONICA_LLM_PROVIDER=codex
HARMONICA_CODEX_MAX_CALLS_PER_HOUR=12
HARMONICA_CODEX_TIMEOUT=180
# HARMONICA_CODEX_BIN=/absolute/path/to/codex
HARMONICA_CODEX_MODEL=gpt-6.1-sol
# Used only for explicitly enabled legacy API mode.
HARMONICA_LLM_MODEL=gpt-6-luna
HARMONICA_INTAKE_AI_MODEL=gpt-6.1-sol

# Optional owner Apify credential. Community contributions are encrypted in SQLite.
# APIFY_TOKEN=...
# APIFY_TOKEN_SECOND_ACCOUNT=...
HARMONICA_APIFY_MONTHLY_BUDGET_USD=4
# Set 0 on non-macOS or to disable the existing Harmonica-only Keychain fallback.
HARMONICA_APIFY_USE_KEYCHAIN=1
# Instagram public endpoint fallback is opt-in; default collection uses Apify.
HARMONICA_INSTAGRAM_PUBLIC_FALLBACK=0
