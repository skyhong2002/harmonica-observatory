# Copy to .env locally. Never commit real credentials.
# The web installer supplies public origin/trusted proxy for the local Caddy setup.
HARMONICA_PUBLIC_ORIGIN=https://harmonica.observe.tw
HARMONICA_TRUST_PROXY=1

# Local AI gateway (OpenAI-compatible). Request aliases only; the gateway picks models.
HARMONICA_LLM_PROVIDER=gateway
# HARMONICA_LLM_BASE_URL=http://127.0.0.1:8317/v1
# HARMONICA_LLM_MODEL=sky-fast
# HARMONICA_INTAKE_AI_MODEL=sky-quality
# HARMONICA_LLM_MAX_CALLS_PER_HOUR=120
# Key: prefer Keychain (service harmonica-ai-gateway, account harmonica) over this file.
# HARMONICA_LLM_API_KEY=...

# Fallback: saved local `codex login` session (HARMONICA_LLM_PROVIDER=codex).
# HARMONICA_CODEX_MAX_CALLS_PER_HOUR=12
# HARMONICA_CODEX_TIMEOUT=180
# HARMONICA_CODEX_BIN=/absolute/path/to/codex
# HARMONICA_CODEX_MODEL=

# Optional owner Apify credential. Community contributions are encrypted in SQLite.
# APIFY_TOKEN=...
# APIFY_TOKEN_SECOND_ACCOUNT=...
HARMONICA_APIFY_MONTHLY_BUDGET_USD=4
# Set 0 on non-macOS or to disable the existing Harmonica-only Keychain fallback.
HARMONICA_APIFY_USE_KEYCHAIN=1
# Instagram public endpoint fallback is opt-in; default collection uses Apify.
HARMONICA_INSTAGRAM_PUBLIC_FALLBACK=0

# Optional InstaStoriesViewer pilot. Explicit allowlist required; no paid actor.
# Scheduled runs: at most 1 account / 3 hours and each account at most / 12 hours.
HARMONICA_ISV_ENABLED=0
HARMONICA_ISV_ACCOUNTS=siriusharmonicaensemble,nycu_harmonica,aidensoon,taiwanharmonica
HARMONICA_ISV_BATCH_SIZE=1

# Website Google login (separate from calendar ingestion credentials).
# HARMONICA_LOGIN_GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# HARMONICA_LOGIN_GOOGLE_CLIENT_SECRET=...
# Register https://harmonica.observe.tw/auth/google/callback in Google Auth Platform.
