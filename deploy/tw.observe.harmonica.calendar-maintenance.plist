<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
 "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>tw.observe.harmonica.calendar-maintenance</string>

    <key>ProgramArguments</key>
    <array>
      <string>/bin/zsh</string>
      <string>-lc</string>
      <string>cd '/Users/skyhong/Projects/Harmonica-in-Taiwan' &amp;&amp; PYTHONWARNINGS=ignore '/Users/skyhong/.hermes/harmonica-intake-venv/bin/python' scripts/sync_google_calendar_events.py --history-days 365 --required</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/skyhong/Projects/Harmonica-in-Taiwan</string>

    <key>ProcessType</key>
    <string>Background</string>

    <key>EnvironmentVariables</key>
    <dict>
      <key>HOME</key>
      <string>/Users/skyhong</string>
      <key>PATH</key>
      <string>/Users/skyhong/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
      <key>PYTHONWARNINGS</key>
      <string>ignore</string>
      <key>HARMONICA_GOOGLE_CALENDAR_CLIENT</key>
      <string>rest</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>StartCalendarInterval</key>
    <dict>
      <key>Hour</key>
      <integer>4</integer>
      <key>Minute</key>
      <integer>10</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/skyhong/Library/Logs/Harmonica-in-Taiwan/calendar-maintenance.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/skyhong/Library/Logs/Harmonica-in-Taiwan/calendar-maintenance.err.log</string>
  </dict>
</plist>
